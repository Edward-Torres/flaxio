# ===== PostgreSQL =====
POSTGRES_USER=flaxio
POSTGRES_PASSWORD=flaxio-dev-password
POSTGRES_DB=flaxio

# ===== Backend =====
DATABASE_URL=postgresql://flaxio:flaxio-dev-password@db:5432/flaxio?schema=public
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PORT=4000
CORS_ORIGIN=http://localhost:3010
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ===== App =====
APP_PORT=3010
